{
  "name": "worktrunk-vscode",
  "displayName": "Worktrunk Worktrees",
  "description": "Every git worktree of the open repo, with its PR, CI and merge state, powered by the Worktrunk CLI.",
  "version": "0.1.0",
  "publisher": "abubakarsiddik31",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14532d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktrunk",
          "title": "Worktrees",
          "icon": "media/worktrees.svg"
        }
      ]
    },
    "views": {
      "worktrunk": [
        {
          "id": "worktrunk.worktrees",
          "name": "Worktrees",
          "contextualTitle": "Worktrunk"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktrunk.worktrees",
        "when": "worktrunk.cliMissing",
        "contents": "This view needs the Worktrunk CLI, which was not found.\n[Install Worktrunk](https://worktrunk.dev/#install)\nmacOS and Linux: `brew install worktrunk`. Windows: `winget install max-sixty.worktrunk`.\nAlready installed somewhere unusual?\n[Choose the wt Binary…](command:worktrunk.chooseExecutable)\n[Try Again](command:worktrunk.refresh)"
      },
      {
        "view": "worktrunk.worktrees",
        "when": "!worktrunk.cliMissing && workbenchState == empty",
        "contents": "Open a folder inside a git repository to see its worktrees.\n[Open Folder](command:workbench.action.files.openFolder)"
      }
    ],
    "commands": [
      {
        "command": "worktrunk.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.selectRepository",
        "title": "Select Repository",
        "icon": "$(repo)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.create",
        "title": "New Worktree…",
        "icon": "$(add)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.checkoutPr",
        "title": "Check Out Pull Request…",
        "icon": "$(git-pull-request)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.removeMerged",
        "title": "Remove All Merged Worktrees…",
        "icon": "$(clear-all)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.openCurrentPr",
        "title": "Open This Worktree's Pull Request",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.prune",
        "title": "Prune Missing Worktrees",
        "icon": "$(trash)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.showInTerminal",
        "title": "Show wt list in Terminal",
        "icon": "$(terminal)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.openNewWindow",
        "title": "Open in New Window",
        "icon": "$(empty-window)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.openHere",
        "title": "Open in This Window",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.openPr",
        "title": "Open Pull Request",
        "icon": "$(github)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.openTerminal",
        "title": "Open Terminal Here",
        "icon": "$(terminal)",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.revealInFinder",
        "title": "Reveal in File Manager",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.copyPath",
        "title": "Copy Path",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.copyBranch",
        "title": "Copy Branch Name",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.lock",
        "title": "Lock Worktree…",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.unlock",
        "title": "Unlock Worktree",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.remove",
        "title": "Remove Worktree…",
        "category": "Worktrunk"
      },
      {
        "command": "worktrunk.chooseExecutable",
        "title": "Choose the wt Binary…",
        "category": "Worktrunk"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktrunk.selectRepository",
          "when": "view == worktrunk.worktrees && worktrunk.multiRoot",
          "group": "navigation@0"
        },
        {
          "command": "worktrunk.create",
          "when": "view == worktrunk.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "worktrunk.checkoutPr",
          "when": "view == worktrunk.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "worktrunk.refresh",
          "when": "view == worktrunk.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "worktrunk.showInTerminal",
          "when": "view == worktrunk.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "worktrunk.prune",
          "when": "view == worktrunk.worktrees",
          "group": "1_manage"
        },
        {
          "command": "worktrunk.removeMerged",
          "when": "view == worktrunk.worktrees",
          "group": "1_manage@1"
        }
      ],
      "view/item/context": [
        {
          "command": "worktrunk.removeMerged",
          "when": "view == worktrunk.worktrees && viewItem == group:merged",
          "group": "inline@1"
        },
        {
          "command": "worktrunk.openPr",
          "when": "view == worktrunk.worktrees && viewItem =~ /:pr\\b/",
          "group": "inline@1"
        },
        {
          "command": "worktrunk.openNewWindow",
          "when": "view == worktrunk.worktrees && viewItem =~ /:present\\b/",
          "group": "inline@2"
        },
        {
          "command": "worktrunk.openNewWindow",
          "when": "view == worktrunk.worktrees && viewItem =~ /:present\\b/",
          "group": "1_open@1"
        },
        {
          "command": "worktrunk.openHere",
          "when": "view == worktrunk.worktrees && viewItem =~ /:present\\b/",
          "group": "1_open@2"
        },
        {
          "command": "worktrunk.openTerminal",
          "when": "view == worktrunk.worktrees && viewItem =~ /:present\\b/",
          "group": "1_open@3"
        },
        {
          "command": "worktrunk.revealInFinder",
          "when": "view == worktrunk.worktrees && viewItem =~ /:present\\b/",
          "group": "1_open@4"
        },
        {
          "command": "worktrunk.openPr",
          "when": "view == worktrunk.worktrees && viewItem =~ /:pr\\b/",
          "group": "2_pr@1"
        },
        {
          "command": "worktrunk.copyPath",
          "when": "view == worktrunk.worktrees && viewItem =~ /^worktree\\b/",
          "group": "3_copy@1"
        },
        {
          "command": "worktrunk.copyBranch",
          "when": "view == worktrunk.worktrees && viewItem =~ /:branch\\b/",
          "group": "3_copy@2"
        },
        {
          "command": "worktrunk.lock",
          "when": "view == worktrunk.worktrees && viewItem =~ /:unlocked\\b/",
          "group": "8_lock@1"
        },
        {
          "command": "worktrunk.unlock",
          "when": "view == worktrunk.worktrees && viewItem =~ /:locked\\b/",
          "group": "8_lock@1"
        },
        {
          "command": "worktrunk.remove",
          "when": "view == worktrunk.worktrees && viewItem =~ /:removable\\b/",
          "group": "9_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "worktrunk.openNewWindow",
          "when": "false"
        },
        {
          "command": "worktrunk.openHere",
          "when": "false"
        },
        {
          "command": "worktrunk.openPr",
          "when": "false"
        },
        {
          "command": "worktrunk.openTerminal",
          "when": "false"
        },
        {
          "command": "worktrunk.revealInFinder",
          "when": "false"
        },
        {
          "command": "worktrunk.copyPath",
          "when": "false"
        },
        {
          "command": "worktrunk.copyBranch",
          "when": "false"
        },
        {
          "command": "worktrunk.remove",
          "when": "false"
        },
        {
          "command": "worktrunk.selectRepository",
          "when": "worktrunk.multiRoot"
        },
        {
          "command": "worktrunk.lock",
          "when": "false"
        },
        {
          "command": "worktrunk.unlock",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Worktrunk",
      "properties": {
        "worktrunk.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `wt` binary. Empty looks in Homebrew, Cargo and `PATH`."
        },
        "worktrunk.refreshIntervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "markdownDescription": "Refresh PR and CI status this often. `0` refreshes only on demand and when the window regains focus."
        },
        "worktrunk.findPrsForOtherWorktrees": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use `gh` to find the PR behind worktrees Worktrunk shows none for — detached review checkouts and merged branches."
        },
        "worktrunk.hideBranchPrefix": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show `alice/fix-login` as `fix-login`: drop everything before the first `/` of a branch name."
        },
        "worktrunk.openAfterCreate": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "newWindow",
            "currentWindow",
            "none"
          ],
          "enumDescriptions": [
            "Ask each time",
            "Open it in a new window",
            "Open it in this window",
            "Leave it closed"
          ],
          "markdownDescription": "What to do with a worktree once it is created."
        },
        "worktrunk.statusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the pull request and CI state of the worktree this window has open in the status bar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o worktrunk-vscode.vsix",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
